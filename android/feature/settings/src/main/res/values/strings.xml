    <!-- SET help screen -->
    <string name="settings_help_faq_title">Frequently asked questions</string>
    <string name="settings_help_faq1_q">Are my conversations really end-to-end encrypted?</string>
    <string name="settings_help_faq1_a">Yes. Messages and media are encrypted on your device and can only be decrypted on the recipient device. Servers only ever see ciphertext.</string>
    <string name="settings_help_faq2_q">What happens to my backups?</string>
    <string name="settings_help_faq2_a">Backups are encrypted with your passphrase and stored only where you choose them. ChattlyX never uploads them.</string>
    <string name="settings_help_faq3_q">How do I lock the app?</string>
    <string name="settings_help_faq3_a">Turn on App lock on the Settings home screen and confirm with your fingerprint or device credential.</string>
    <string name="settings_help_support">Need more help? Check the About screen for your app version when contacting support.</string>

