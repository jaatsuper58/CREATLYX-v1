<?xml version="1.0" encoding="utf-8"?>
<!--
  TLS-only transport (master spec Section 9.2). Certificate pins for the
  production API host are added here once the host exists; ship a primary AND a
  backup pin with expiration dates, and rotate before expiry.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
