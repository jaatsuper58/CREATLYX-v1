    <!-- SET privacy screen -->
    <string name="settings_privacy_e2ee_title">End-to-end encryption</string>
    <string name="settings_privacy_e2ee_body">Messages, media and calls are encrypted on your device. Only you and the person you are talking to can read them.</string>
    <string name="settings_privacy_minimal_title">Minimal data collection</string>
    <string name="settings_privacy_minimal_body">We process only what delivers your messages: your phone number, the profile details you add, and transient routing data. No ads, no third-party analytics.</string>
    <string name="settings_privacy_backups_title">Backups stay yours</string>
    <string name="settings_privacy_backups_body">Local backups are encrypted with your own passphrase and never leave your device through ChattlyX.</string>
    <string name="settings_privacy_lock_title">App lock</string>
    <string name="settings_privacy_lock_body">Protect the app with biometrics or your device credential when you step away. Turn it on from the Settings home screen.</string>

